# Application
NODE_ENV=production
PORT=3000

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://hugo.example.eu

# Google OAuth (app login only — separate from Drive service account)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated allowlist enforced on every authenticated request
ALLOWED_EMAILS=accountant@example.com

# SQLite database file path (created and migrated on first boot)
DATABASE_PATH=/var/lib/hugo/hugo.db

# E2E tests only — enables credentials provider; must be false in production
E2E_TEST_AUTH=false

# Read documents as they arrive in Drive (ADR 0020). The webhook needs this
# app's public HTTPS URL; without it the app polls only.
DRIVE_WEBHOOK_URL=https://hugo.example.eu/api/drive/notifications
# Sweep and queue every 15 minutes; 0 turns the poll off.
# DRIVE_POLL_INTERVAL_MS=900000
# Documents read at once — the model server's slots (EXTRACTOR_PARALLEL).
# EXTRACTOR_CONCURRENCY=1
