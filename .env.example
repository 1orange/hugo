# Application
NODE_ENV=production
PORT=3000

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://hugo.example.eu

# Google OAuth (app login only — separate from Drive service account)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated allowlist enforced on every authenticated request
ALLOWED_EMAILS=accountant@example.com

# Postgres (migrated by every replica on start, once, under an advisory lock)
DATABASE_URL=postgres://hugo:password@postgres:5432/hugo
# DATABASE_POOL_MAX=10

# Redis: job queues, events to the browsers, the worker's service checks (ADR 0021)
REDIS_URL=redis://redis:6379
# Key and channel prefix, so two deployments can share one Redis.
# HUGO_REDIS_PREFIX=hugo

# What this process does: web (pages, queues work), worker (reads documents,
# sweeps Drive), or all (both; the default outside production).
HUGO_ROLE=web
# The worker's /healthz for Kubernetes probes.
# WORKER_HEALTH_PORT=9464

# E2E tests only — enables credentials provider; must be false in production
E2E_TEST_AUTH=false

# Read documents as they arrive in Drive (ADR 0020). The webhook needs this
# app's public HTTPS URL; without it the app polls only.
DRIVE_WEBHOOK_URL=https://hugo.example.eu/api/drive/notifications
# Sweep and queue every 15 minutes; 0 turns the poll off.
# DRIVE_POLL_INTERVAL_MS=900000
# Documents read at once across all workers — the model server's slots (EXTRACTOR_PARALLEL).
# EXTRACTOR_CONCURRENCY=1

# The model and OCR sidecars (ADR 0017), as the worker reaches them.
EXTRACTOR_URL=http://extractor:8080/v1
EXTRACTOR_MODEL=local
OCR_URL=http://ocr:8090
