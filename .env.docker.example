# Copy beside docker-compose.yml: cp .env.docker.example .env.docker
# Used by: docker compose --env-file .env.docker up -d
#          scripts/benchmark-compare-models.sh (default COMPOSE_ENV)

EXTRACTOR_PORT=8080
EXTRACTOR_THREADS=4
EXTRACTOR_MODEL_DIR=./models

# Default after ADR 0017 model-choice amendment (replace once benchmark table is filled).
EXTRACTOR_MODEL_FILE=Qwen2.5-0.5B-Instruct-Q4_K_M.gguf
EXTRACTOR_MODEL=local

OCR_PORT=8090

# App / harness when calling the sidecar (host machine, not inside compose):
# EXTRACTOR_URL=http://127.0.0.1:8080/v1
# OCR_URL=http://127.0.0.1:8090
# EXTRACTOR_THINKING=false
